<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GHQuickSearch</AssemblyName>
    <TargetExt>.gha</TargetExt>
    <Version>0.4.16</Version>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">C:/Program Files/Rhino 8/System</RhinoSystemDir>
    <GrasshopperDir Condition="'$(GrasshopperDir)' == ''">C:/Program Files/Rhino 8/Plug-ins/Grasshopper</GrasshopperDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystemDir)/RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Grasshopper"><HintPath>$(GrasshopperDir)/Grasshopper.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GH_IO"><HintPath>$(GrasshopperDir)/GH_IO.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>


















